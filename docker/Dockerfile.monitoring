# Monitoring dashboard image: reads monitoring/metrics_history.jsonl and
# monitoring/query_log.jsonl. Same lightweight base as the GenAI image --
# no Spark/Java needed here either.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8502

ENTRYPOINT ["streamlit", "run", "monitoring/dashboard.py", "--server.address=0.0.0.0", "--server.port=8502"]
